<?php
// Configuración de la conexión a la base de datos
$servername = "localhost";
$username = "root"; 
$password = ""; 
$dbname = "hospital"; 

$conn = new mysqli($servername, $username, $password, $dbname);

if ($conn->connect_error) {
    die("Conexión fallida: " . $conn->connect_error);
}

// Procesar formulario
if ($_SERVER["REQUEST_METHOD"] == "POST") {
    if (isset($_POST["registro_paciente"])) {
        $nombre = $_POST["nombre"];
        $apellidoP = $_POST["apellidoP"];
        $apellidoM = $_POST["apellidoM"];
        $fechaNaci = $_POST["fechaNaci"];
        $sexo = $_POST["sexo"];

        $sql_paciente = "INSERT INTO paciente (nombre, apellidoP, apellidoM, fechaNaci, sexo) 
                         VALUES ('$nombre', '$apellidoP', '$apellidoM', '$fechaNaci', '$sexo')";
        ejecutarConsulta($sql_paciente, "Paciente registrado correctamente.");
    }

    if (isset($_POST["registro_contacto"])) {
        $nombre = $_POST["nombre"];
        $apellidoP = $_POST["apellidoP"];
        $apellidoM = $_POST["apellidoM"];
        $telefono = $_POST["telefono"];
        $correo = $_POST["correo"];
        $mensaje = $_POST["mensaje"];

        $sql_contacto = "INSERT INTO contacto (nombre, apellidoP, apellidoM, telefono, correo, mensaje) 
                         VALUES ('$nombre', '$apellidoP', '$apellidoM', '$telefono', '$correo', '$mensaje')";
        ejecutarConsulta($sql_contacto, "Contacto registrado correctamente.");
    }

    if (isset($_POST["registro_medico"])) {
        $nombre = $_POST["nombre"];
        $apellidoP = $_POST["apellidoP"];
        $apellidoM = $_POST["apellidoM"];
        $especialidad = $_POST["especialidad"];
        $consultorio = $_POST["consultorio"];

        $sql_medico = "INSERT INTO medico (nombre, apellidoP, apellidoM, especialidad, consultorio) 
                       VALUES ('$nombre', '$apellidoP', '$apellidoM', '$especialidad', '$consultorio')";
        ejecutarConsulta($sql_medico, "Médico registrado correctamente.");
    }

    if (isset($_POST["registro_cita"])) {
        $idPaciente = $_POST["idPaciente"];
        $idDoctor = $_POST["idDoctor"];
        $estudio = $_POST["estudio"];
        $fecha = $_POST["fecha"];
        $hora = $_POST["hora"];
        $precio = $_POST["precio"];

        $sql_cita = "INSERT INTO cita (idPaciente, idDoctor, estudio, fecha, hora, precio) 
                     VALUES ('$idPaciente', '$idDoctor', '$estudio', '$fecha', '$hora', '$precio')";
        ejecutarConsulta($sql_cita, "Cita registrada correctamente.");
    }
}

function ejecutarConsulta($sql, $mensaje) {
    global $conn;
    if ($conn->query($sql) === TRUE) {
        echo "<p style='color:green;'>$mensaje</p>";
    } else {
        echo "<p style='color:red;'>Error: " . $conn->error . "</p>";
    }
}

$conn->close();
?>

